# If using MongoDB Atlas, paste your Atlas connection string below.
# If using Railway's built-in MongoDB plugin, Railway sets MONGODB_URL automatically —
# just add MONGODB_URI in the Variables tab pointing to the same value.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/cryptoDB
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=https://your-netlify-site.netlify.app
NODE_ENV=production
